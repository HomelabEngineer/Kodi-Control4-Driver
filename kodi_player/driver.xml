<?xml version="1.0" encoding="UTF-8"?>
<devicedata>
  <copyright>Open Source (MIT License)</copyright>
  <creator>Open Source</creator>
  <manufacturer>Kodi</manufacturer>
  <name>Kodi</name>
  <model>Kodi Player (Open Source)</model>
  <created>10/18/2026 12:00 PM</created>
  <modified>10/18/2026 12:00 PM</modified>
  <version>100</version>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <minimum_os_version>3.0.0</minimum_os_version>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>

  <composer_categories>
    <category>media_player</category>
  </composer_categories>

  <proxies qty="2">
    <!-- The room's video source and remote control target. -->
    <proxy proxybindingid="5001" name="Kodi" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">media_player</proxy>
    <!--
      Virtual switcher. Owns the single physical HDMI output and aggregates the
      media player and the linked Kodi Movies service, so one binding to the
      TV/AVR serves both. Hidden from rooms by the driver.
    -->
    <proxy proxybindingid="5002" name="Kodi Virtual Switcher" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">avswitch</proxy>
  </proxies>

  <capabilities>
    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon width="20" height="20">controller://driver/kodi_os_player/icons/device_20.png</Icon>
        <Icon width="30" height="30">controller://driver/kodi_os_player/icons/device_30.png</Icon>
        <Icon width="40" height="40">controller://driver/kodi_os_player/icons/device_40.png</Icon>
        <Icon width="50" height="50">controller://driver/kodi_os_player/icons/device_50.png</Icon>
        <Icon width="60" height="60">controller://driver/kodi_os_player/icons/device_60.png</Icon>
        <Icon width="70" height="70">controller://driver/kodi_os_player/icons/device_70.png</Icon>
        <Icon width="80" height="80">controller://driver/kodi_os_player/icons/device_80.png</Icon>
        <Icon width="90" height="90">controller://driver/kodi_os_player/icons/device_90.png</Icon>
        <Icon width="100" height="100">controller://driver/kodi_os_player/icons/device_100.png</Icon>
        <Icon width="110" height="110">controller://driver/kodi_os_player/icons/device_110.png</Icon>
        <Icon width="120" height="120">controller://driver/kodi_os_player/icons/device_120.png</Icon>
        <Icon width="130" height="130">controller://driver/kodi_os_player/icons/device_130.png</Icon>
        <Icon width="140" height="140">controller://driver/kodi_os_player/icons/device_140.png</Icon>
        <Icon width="300" height="300">controller://driver/kodi_os_player/icons/device_300.png</Icon>
      </display_icons>
    </navigator_display_option>

    <!-- SCAN_FWD/SCAN_REV opt into the remote's << >> keys, DPAD into the directional pad. -->
    <transports>
      <supported>PLAY, PAUSE, STOP, SKIP_FWD, SKIP_REV, SCAN_FWD, SCAN_REV, DPAD</supported>
      <dashboard>
        <buttons>
          <button><id>SCAN_REV</id><name>SCAN_REV</name><command>SCAN_REV</command><type>PROXY</type></button>
          <button><id>SKIP_REV</id><name>SKIP_REV</name><command>SKIP_REV</command><type>PROXY</type></button>
          <button><id>PLAY</id><name>PLAY</name><command>PLAY</command><type>PROXY</type></button>
          <button><id>PAUSE</id><name>PAUSE</name><command>PAUSE</command><type>PROXY</type></button>
          <button><id>STOP</id><name>STOP</name><command>STOP</command><type>PROXY</type></button>
          <button><id>SKIP_FWD</id><name>SKIP_FWD</name><command>SKIP_FWD</command><type>PROXY</type></button>
          <button><id>SCAN_FWD</id><name>SCAN_FWD</name><command>SCAN_FWD</command><type>PROXY</type></button>
        </buttons>
        <default_large>SCAN_REV, SKIP_REV, PLAY, PAUSE, SKIP_FWD, SCAN_FWD</default_large>
        <default_small>SKIP_REV, PLAY, PAUSE, SKIP_FWD</default_small>
      </dashboard>
      <button_bar>
        <buttons>
          <button><id>HOME</id><name>Kodi Home</name><command>GUIDE</command><type>PROXY</type></button>
          <button><id>MENU</id><name>Menu</name><command>MENU</command><type>PROXY</type></button>
          <button><id>INFO</id><name>Info</name><command>INFO</command><type>PROXY</type></button>
        </buttons>
        <default_buttons>HOME, MENU, INFO</default_buttons>
      </button_bar>
    </transports>
  </capabilities>

  <connections>
    <!-- ======================= 5001: media_player ======================= -->
    <connection>
      <id>5001</id>
      <type>2</type>
      <connectionname>Media Player</connectionname>
      <consumer>False</consumer>
      <linelevel>False</linelevel>
      <classes>
        <class><classname>MEDIA_PLAYER</classname></class>
      </classes>
    </connection>
    <!-- Internal: media player into the virtual switcher (autobinds). -->
    <connection proxybindingid="5001">
      <id>4001</id>
      <facing>6</facing>
      <type>6</type>
      <connectionname>Kodi Audio to Virtual Switcher</connectionname>
      <consumer>False</consumer>
      <audiosource>True</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <hidden>True</hidden>
      <idautobind>73101</idautobind>
      <classes>
        <class><classname>STEREO</classname><autobind>True</autobind></class>
        <class><classname>DIGITAL_OPTICAL</classname><autobind>True</autobind></class>
        <class><classname>DIGITAL_COAX</classname><autobind>True</autobind></class>
        <class><classname>MULTI_STEREO</classname><autobind>True</autobind></class>
      </classes>
    </connection>
    <connection proxybindingid="5001">
      <id>2002</id>
      <facing>6</facing>
      <type>6</type>
      <connectionname>Kodi Video to Virtual Switcher</connectionname>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <hidden>True</hidden>
      <idautobind>73102</idautobind>
      <classes>
        <class><classname>HDMI</classname><autobind>True</autobind></class>
        <class><classname>COMPONENT</classname><autobind>True</autobind></class>
        <class><classname>COMPOSITE</classname><autobind>True</autobind></class>
      </classes>
    </connection>

    <!-- ======================= 5002: virtual switcher ======================= -->
    <connection>
      <id>5002</id>
      <type>2</type>
      <connectionname>AVSWITCH</connectionname>
      <consumer>False</consumer>
      <linelevel>True</linelevel>
      <classes>
        <class><classname>AVSWITCH</classname></class>
      </classes>
    </connection>
    <connection proxybindingid="5002">
      <id>3001</id>
      <type>6</type>
      <connectionname>Switcher Audio from Kodi</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <hidden>True</hidden>
      <idautobind>73101</idautobind>
      <classes>
        <class><classname>STEREO</classname><autobind>True</autobind></class>
        <class><classname>DIGITAL_OPTICAL</classname><autobind>True</autobind></class>
        <class><classname>DIGITAL_COAX</classname><autobind>True</autobind></class>
        <class><classname>MULTI_STEREO</classname><autobind>True</autobind></class>
      </classes>
    </connection>
    <connection proxybindingid="5002">
      <id>1001</id>
      <type>6</type>
      <connectionname>Switcher Video from Kodi</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <hidden>True</hidden>
      <idautobind>73102</idautobind>
      <classes>
        <class><classname>HDMI</classname><autobind>True</autobind></class>
        <class><classname>COMPONENT</classname><autobind>True</autobind></class>
        <class><classname>COMPOSITE</classname><autobind>True</autobind></class>
      </classes>
    </connection>
    <!--
      Receiving side of the Kodi Movies media service. These autobind when both
      drivers are in the project; if they do not, bind them by hand in
      Connections (Kodi Movies -> Kodi Virtual Switcher).
    -->
    <connection proxybindingid="5002">
      <id>201</id>
      <facing>6</facing>
      <type>1</type>
      <connectionname>Kodi Movies Link</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <idautobind>73103</idautobind>
      <classes>
        <class><classname>LINK_OSKODI_MOVIES</classname><autobind>True</autobind></class>
      </classes>
    </connection>
    <connection proxybindingid="5002">
      <id>3101</id>
      <type>6</type>
      <connectionname>Kodi Movies AV</connectionname>
      <consumer>True</consumer>
      <linelevel>False</linelevel>
      <idautobind>73104</idautobind>
      <classes>
        <class><classname>RF_OSKODI_MOVIES</classname><autobind>True</autobind></class>
      </classes>
    </connection>
    <!-- The real outputs: bind HDMI OUTPUT to the TV/AVR input Kodi is plugged into. -->
    <connection proxybindingid="5002">
      <id>2000</id>
      <type>5</type>
      <connectionname>HDMI OUTPUT</connectionname>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class><classname>HDMI</classname></class>
        <class><classname>COMPONENT</classname></class>
        <class><classname>COMPOSITE</classname></class>
      </classes>
    </connection>
    <connection proxybindingid="5002">
      <id>4000</id>
      <type>6</type>
      <connectionname>Audio OUTPUT</connectionname>
      <consumer>False</consumer>
      <audiosource>True</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class><classname>STEREO</classname></class>
        <class><classname>DIGITAL_OPTICAL</classname></class>
        <class><classname>DIGITAL_COAX</classname></class>
      </classes>
    </connection>
    <connection proxybindingid="5002">
      <id>7000</id>
      <type>7</type>
      <connectionname>Room Selection - OUTPUT</connectionname>
      <consumer>False</consumer>
      <audiosource>True</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class><classname>AUDIO_SELECTION</classname></class>
        <class><classname>AUDIO_VOLUME</classname></class>
        <class><classname>VIDEO_SELECTION</classname></class>
      </classes>
    </connection>

    <!-- ======================= Driver-to-driver control link ======================= -->
    <connection>
      <id>3900</id>
      <facing>6</facing>
      <type>1</type>
      <connectionname>Kodi Library Control</connectionname>
      <consumer>False</consumer>
      <linelevel>False</linelevel>
      <idautobind>73105</idautobind>
      <classes>
        <class><classname>OSKODI_PLAYER_LINK</classname><autobind>True</autobind></class>
      </classes>
    </connection>
  </connections>

  <config>
    <documentation file="www/documentation.html"/>
    <script file="driver.lua"/>

    <actions>
      <action><name>Reconnect WebSocket</name><command>ACTION_ReconnectWebSocket</command></action>
      <action><name>Disconnect WebSocket</name><command>ACTION_DisconnectWebSocket</command></action>
      <action><name>Scan Kodi Video Library</name><command>ACTION_ScanVideoLibrary</command></action>
      <action><name>Refresh Linked Kodi Movies</name><command>ACTION_PushLibraryConfig</command></action>
    </actions>

    <events>
      <event><id>1</id><name>Playback Started</name><description>Video playback started on Kodi</description></event>
      <event><id>2</id><name>Playback Paused</name><description>Video playback paused</description></event>
      <event><id>3</id><name>Playback Resumed</name><description>Video playback resumed</description></event>
      <event><id>4</id><name>Playback Stopped</name><description>Video playback stopped</description></event>
      <event><id>5</id><name>Playback Ended</name><description>Video played to the end</description></event>
      <event><id>6</id><name>Library Movie Launched</name><description>A movie picked in Kodi Movies started</description></event>
    </events>

    <commands>
      <command>
        <name>Kodi Action</name>
        <description>Kodi: send action PARAM1</description>
        <params>
          <param><name>Action</name><type>STRING</type><default>osd</default></param>
        </params>
      </command>
      <command>
        <name>Show Notification</name>
        <description>Kodi: show notification PARAM1 / PARAM2</description>
        <params>
          <param><name>Title</name><type>STRING</type><default>Control4</default></param>
          <param><name>Message</name><type>STRING</type><default></default></param>
          <param><name>Seconds</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>60</maximum><default>5</default></param>
        </params>
      </command>
      <command>
        <name>Open Movies Library</name>
        <description>Kodi: open the Movies library window</description>
      </command>
      <command>
        <name>Scan Video Library</name>
        <description>Kodi: scan the video library for new content</description>
      </command>
    </commands>

